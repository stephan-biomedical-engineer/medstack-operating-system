#!/bin/sh
# SPDX-License-Identifier: MIT
#
# What the menu icon runs, as the desktop user. Asks for this user's EEG
# station by leaving a request where the host's medplatform-requests.path
# watches, and never asks systemd directly - so there is no password prompt
# (medplatform-requests.path says why). The request is answered as root by
# medplatform-station-request: start the station if it is not running, then
# open its operator display. Closing that display ends the station.
set -eu

user=$(id -un)
requests=/run/medplatform-requests
unit="medplatform-station@$user.service"

# Started from a menu, stderr goes nowhere; say it on the desktop too.
fail() {
    echo "medplatform-station: $1" >&2
    command -v notify-send >/dev/null 2>&1 && notify-send -i dialog-error "MedPlatform EEG" "$1" || true
    exit 1
}

case "${1:-open}" in
    open|stop) verb=${1:-open} ;;
    *)
        echo "usage: $0 [open|stop]" >&2
        exit 2
        ;;
esac

if [ "$verb" = open ]; then
    [ -n "${WAYLAND_DISPLAY:-}" ] || fail "this desktop session is not Wayland; log in with a Wayland session (Ubuntu on Wayland)."
fi
id -nG "$user" | tr ' ' '\n' | grep -qx medplatform \
    || fail "$user is not in the medplatform group: sudo usermod -aG medplatform $user, and try again."
[ -d "$requests" ] || fail "the station's request service is not running: sudo systemctl enable --now medplatform-requests.path"

request="$requests/$verb.$user"
: > "$request" || fail "could not leave a request in $requests"

# Answered when the file is gone. Starting the container is the slow part;
# twenty seconds is generous for a boot with no hardware to probe.
i=0
while [ -e "$request" ]; do
    i=$((i + 1))
    [ "$i" -le 100 ] || fail "the station did not answer: journalctl -u medplatform-requests.service"
    sleep 0.2
done

if [ "$verb" = open ] && ! systemctl is-active --quiet "$unit"; then
    fail "the station did not start: journalctl -u $unit"
fi
