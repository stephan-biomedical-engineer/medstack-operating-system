// A member of the medplatform group may start, stop and restart their own EEG
// station, and ask it for the operator display, from the menu without a
// password - their own instances only (medplatform-station@<their name> and
// medplatform-station-open@<their name>), and nothing else systemd does.
polkit.addRule(function(action, subject) {
    if (action.id != "org.freedesktop.systemd1.manage-units" ||
        !subject.isInGroup("medplatform") || !subject.local || !subject.active) {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    if (unit == "medplatform-station@" + subject.user + ".service" &&
        (verb == "start" || verb == "stop" || verb == "restart")) {
        return polkit.Result.YES;
    }
    if (unit == "medplatform-station-open@" + subject.user + ".service" && verb == "start") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
