#!/bin/sh
# medplatform-station: a running station is halted (a recording is closed on the
# way down) before its tree is replaced or removed.
set -e

case "$1" in
remove|upgrade|deconfigure)
    systemctl stop 'medplatform-station@*.service' >/dev/null 2>&1 || true
    if [ "$1" = remove ]; then
        systemctl disable --now medplatform-requests.path >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
