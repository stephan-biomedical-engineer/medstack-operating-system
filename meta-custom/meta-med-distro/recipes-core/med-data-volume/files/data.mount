[Unit]
Description=MedPlatform persistent data volume (/data)
Documentation=man:crypttab(5)
DefaultDependencies=no
Conflicts=umount.target
Before=umount.target
After=systemd-cryptsetup@med\x2ddata.service
Requires=systemd-cryptsetup@med\x2ddata.service

# Targets without the partition - QEMU simulation being the obvious one - skip
# this unit instead of failing it, so a development image boots clean and
# MedicalStorage simply reports the volume as unavailable.
ConditionPathExists=/dev/mapper/med-data

[Mount]
What=/dev/mapper/med-data
Where=/data
Type=ext4
Options=noatime,nodev,nosuid,noexec

[Install]
WantedBy=local-fs.target
