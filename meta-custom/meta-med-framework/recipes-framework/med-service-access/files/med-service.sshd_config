# MedOS service access (ACE-03, docs/CONFORMIDADE.md). Not the stock
# sshd_config, which this listener never reads: one user, one key per window,
# no password, no root, nothing forwarded.
HostKey /run/med-service/ssh_host_ed25519_key
AuthorizedKeysFile /run/med-service/authorized_keys
AllowUsers med-service
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
UsePAM no
StrictModes yes
AllowTcpForwarding no
AllowStreamLocalForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no
PermitUserEnvironment no
MaxAuthTries 3
MaxSessions 2
LoginGraceTime 30
ClientAliveInterval 30
ClientAliveCountMax 3
LogLevel VERBOSE
PrintMotd no
