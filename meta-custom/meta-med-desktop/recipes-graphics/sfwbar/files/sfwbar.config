# MedPlatform station task bar.
#
# One job: show what is open and give a minimised window back. No clock - the
# board has no battery-backed clock, and a wrong time on a medical station is
# worse than none. No network, volume or battery indicators: nothing here has
# any of the three.

layout {
  size = "100%"
  layer = "top"
  mirror = "*"
  exclusive_zone = "auto"

  css = "* { min-height: 30px; }"

  taskbar {
    style = "taskbar"
    rows = 1
    icons = true
    labels = true
    sort = false
    action[Drag] = Focus
  }

  label {
    css = "* { -GtkWidget-hexpand: true; }"
  }
}

#CSS
window {
  background-color: #111821;
  color: #e6edf3;
}

button,
button image {
  min-height: 0px;
  outline-style: none;
  box-shadow: none;
  background-image: none;
  border-image: none;
}

label {
  font: 14px Sans;
  color: #e6edf3;
}

button#taskbar_item {
  padding: 4px 12px;
  margin: 3px 2px;
  border-radius: 6px;
  border: 1px solid #263140;
  background-color: #151c26;
  -GtkWidget-hexpand: false;
}

button#taskbar_item.focused {
  background-color: rgba(63,182,255,0.18);
  border-color: #3fb6ff;
}

button#taskbar_item.minimized label {
  color: alpha(currentColor, 0.55);
}

button#taskbar_item:hover {
  background-color: #1b2430;
}

button#taskbar_item image {
  min-width: 18px;
  min-height: 18px;
  padding-right: 6px;
}
