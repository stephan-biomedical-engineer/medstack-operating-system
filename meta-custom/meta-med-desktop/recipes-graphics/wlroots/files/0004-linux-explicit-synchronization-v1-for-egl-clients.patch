diff --git a/render/egl.c b/render/egl.c
index 8db00e667..5e23731e7 100644
--- a/render/egl.c
+++ b/render/egl.c
@@ -13,6 +13,7 @@
 #include <wlr/util/region.h>
 #include <xf86drm.h>
 #include "render/egl.h"
+#include "types/wlr_linux_explicit_synchronization_v1.h"
 #include "util/env.h"
 
 static enum wlr_log_importance egl_log_importance_to_wlr(EGLint type) {
@@ -671,6 +672,11 @@ static void egl_wl_buffer_handle_release(struct wl_listener *listener,
 		void *data) {
 	struct wlr_egl_wl_buffer *buffer =
 		wl_container_of(listener, buffer, release);
+	// A client that asked for the release through an object of the
+	// explicit synchronization protocol gets it there and nowhere else.
+	if (linux_explicit_synchronization_v1_release_buffer(&buffer->base)) {
+		return;
+	}
