[Unit]
Description=MedPlatform EEG operator display
# The compositor has to be accepting clients before a Wayland client can
# attach - and WHICH compositor is not this unit's business. Whatever package
# an image chose as its compositor ships med-compositor.target, which is
# reached when that compositor's socket is listening, and the environment file
# below, which says where the socket is.
#
# This unit used to name the compositor: Requires=weston.service weston.socket.
# The socket was there for a measured reason - ordering on the service alone
# left a window in which the HMI started, found no socket and aborted, with
# NRestarts settling at 1 on some boots and 0 on others - and that reason now
# lives in the target the single-screen compositor ships. Naming it here is
# what had to go: an image with another compositor could not start this unit
# at all, and a drop-in cannot take a Requires= away.
Requires=med-compositor.target
After=med-compositor.target eeg-acquisition.service
# The HMI is a viewer: it starts whether or not acquisition is up, and shows
# "waiting for the acquisition service" until frames arrive. Coupling the two
# would mean a display fault could stop acquisition.
Wants=eeg-acquisition.service

[Service]
Type=simple
Environment=QT_QPA_PLATFORM=wayland
# WAYLAND_DISPLAY, as an absolute path, from the compositor's package. The
# runtime directory is this unit's own: the toolkit wants one it may write to,
# and the compositor's is the compositor's.
#
# Before this, both were written here for one compositor: XDG_RUNTIME_DIR=/run
# and WAYLAND_DISPLAY=wayland-0, after a first version that named /run/user/0,
# where no socket ever was - Qt aborted with "Could not load the Qt platform
# plugin wayland ... even though it was found", status=6/ABRT, a restart every
# ~7 s, and nothing reported it: Restart=on-failure makes a Type=simple unit
# briefly "active" on every retry.
EnvironmentFile=/usr/lib/medplatform/compositor.env
Environment=XDG_RUNTIME_DIR=/run/eeg-hmi
Environment=MED_EEG_SOCKET=/run/medplatform/eeg.sock
# Somewhere to keep the font cache. The root filesystem is read-only and this
# unit may write nowhere else, so without it fontconfig reports "No writable
# cache directories" on every start and rescans the fonts for every text item
# it lays out. Volatile on purpose: a cache is rebuilt, never trusted across a
# slot switch.
RuntimeDirectory=eeg-hmi
Environment=XDG_CACHE_HOME=/run/eeg-hmi
ExecStart=/usr/bin/eeg-hmi-gui
Restart=on-failure
RestartSec=3s

# Rendering only. The HMI has no business writing records, reaching the
# network or touching the front-end, and IEC 62304 software partitioning is
# only credible if the partition is actually enforced.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=mincore

[Install]
WantedBy=multi-user.target
