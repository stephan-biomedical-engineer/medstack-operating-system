[Unit]
Description=MedPlatform EEG acquisition service
Documentation=file:/etc/medplatform/eeg.conf
# The encrypted record volume, when the machine has one. Wants, not Requires:
# on a target without the partition the mount unit is skipped and the service
# is expected to fail loudly on its own terms (with an audit record) rather
# than be silently held back by systemd.
Wants=data.mount
After=data.mount dbus.service systemd-journald.service
# Boot assessment: the slot this software was installed into is confirmed only
# once boot-complete.target is reached (rauc-mark-good.service is ordered after
# it and requires it), and that target now waits for this service to report
# ready - which it does only after its front-end has started. See RequiredBy=
# below and the comment at reportReady() in the service.
Before=boot-complete.target

[Service]
# notify, not simple: "the process exists" is not "acquisition started", and
# the difference is the one an update has to be judged by. simple also made a
# crash-looping unit look active between attempts (CLAUDE.md, acq-active).
Type=notify
ExecStart=/usr/bin/eeg-acquisition-service --config /etc/medplatform/eeg.conf
Restart=on-failure
RestartSec=2s

# Acquisition is the real-time half of the device. Without this it competes
# with the HMI for CPU and frames arrive late under load.
CPUSchedulingPolicy=rr
CPUSchedulingPriority=50
IOSchedulingClass=realtime

# /run/medplatform (the published sample socket) and /var/lib/medplatform (the
# audit hash chain head) are created and owned by systemd, so they exist with
# the right mode on a read-only rootfs.
RuntimeDirectory=medplatform
RuntimeDirectoryMode=0750
StateDirectory=medplatform
StateDirectoryMode=0700

# Sandboxing. The service handles patient data on a device that cannot be
# patched quickly, so it gets the smallest surface it can still work in.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=no
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# No network of any kind: acquisition talks to a co-processor and to a local
# socket. Anything else would be an exfiltration path for patient data.
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=yes

# The record volume is the only place outside its own runtime/state
# directories this service may write.
ReadWritePaths=/data

# The links the front-end can arrive on. Harmless on targets where the node
# does not exist - DeviceAllow narrows, it does not require.
#
# The rpmsg entries name nodes; the industrial I/O one names a device CLASS,
# "char-iio", resolved by systemd through /proc/devices. That difference is not
# cosmetic. An IIO character device is numbered in probe order, so a node name
# here would be the same race the udev rule exists to remove, and it would have
# to be re-guessed for every board. A class is a statement about what kind of
# hardware this service may talk to, which is what the sandbox is for.
#
# Exercised on hardware on 2026-10-04 (STM32MP257, the usb link): the service
# opened its converter through this line and acquired.
DeviceAllow=/dev/rpmsg0 rw
DeviceAllow=/dev/rpmsg_ctrl0 rw
DeviceAllow=char-iio rw

# An industrial I/O front-end is configured by writing its sysfs attributes,
# and ProtectKernelTunables=yes, together with the rest of this sandbox, mounts
# /sys read-only. That is not a theory: the first time this service met an iio
# front-end it failed on its first write with EROFS, restarted 54 times, and
# reported only "refused to start". (On its own, outside this set of
# properties, ProtectKernelTunables leaves /sys writable - which is how a quick
# test with systemd-run said the opposite.)
#
# The fix keeps the protection and reopens one directory: the front-end's
# adjunct layer links /run/med-afe/eeg0 to the converter's sysfs directory when
# udev sees it, and systemd follows the link when it builds the namespace, so
# only that device's attributes become writable - not /sys, and not /proc/sys.
# A path, not a device number, for the same reason as char-iio above.
#
# "-" because only the iio link creates it: on rpmsg and simulated the path is
# absent and the line is ignored. On iio, a missing link means the front-end
# never appeared, and the service fails on its first write, as it should.
ReadWritePaths=-/run/med-afe/eeg0

[Install]
WantedBy=multi-user.target
# Without this, boot-complete.target requires nothing, and "the boot completed"
# means only "the kernel came up": the slot was confirmed at 12.9 s on the
# board, before this service had run.
RequiredBy=boot-complete.target
